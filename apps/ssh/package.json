{
  "name": "@northstar/ssh-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "check": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "lint": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@northstar/db": "workspace:*",
    "@northstar/git": "workspace:*",
    "dotenv": "17.2.2",
    "drizzle-orm": "catalog:",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ssh2": "1.15.5",
    "tsx": "4.20.5",
    "tsup": "8.5.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
