{
  "name": "@northstar/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "production": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "production": "./dist/schema.js",
      "default": "./src/schema.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/schema.ts src/migrate.ts src/seed.ts --format esm --dts --clean",
    "check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@northstar/core": "workspace:*",
    "@northstar/git": "workspace:*",
    "argon2": "0.44.0",
    "dotenv": "17.2.2",
    "drizzle-orm": "catalog:",
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "0.31.4",
    "tsx": "4.20.5",
    "tsup": "8.5.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
