# This file documents shared deployment values only. Copy the relevant values
# into each app's .env file; Turborepo does not implicitly load root env files.
DATABASE_URL=postgresql://origin:origin@localhost:54321/origin
ORIGIN_BASE_URL=http://localhost:3000
ORIGIN_GIT_URL=http://localhost:4000
ORIGIN_REPOSITORY_ROOT=./data/repositories
ORIGIN_EDITION=community
SESSION_SECRET=replace-with-at-least-32-random-characters
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5.6-terra
