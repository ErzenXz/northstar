# This file documents shared deployment values only. Copy the relevant values
# into each app's .env file; Turborepo does not implicitly load root env files.
DATABASE_URL=postgresql://northstar:northstar@localhost:54321/northstar
NORTHSTAR_BASE_URL=http://localhost:3000
NORTHSTAR_GIT_URL=http://localhost:4000
NORTHSTAR_SSH_URL=ssh://git@localhost:2222
NORTHSTAR_REPOSITORY_ROOT=./data/repositories
NORTHSTAR_ASSET_ROOT=./data/assets
NORTHSTAR_EDITION=community
SESSION_SECRET=replace-with-at-least-32-random-characters
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5.6-terra
